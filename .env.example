# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Secret for Session Authentication (HS256)
JWT_SECRET="your-jwt-secret-key-here"

# Optional: Neon Managed Auth Endpoints
# NEON_AUTH_BASE_URL="https://your-auth-endpoint.neonauth.tech/neondb/auth"
# NEON_AUTH_JWKS_URL="https://your-auth-endpoint.neonauth.tech/neondb/auth/.well-known/jwks.json"

# Base URL for Production Deployment & SEO Canonical Links
NEXT_PUBLIC_APP_URL="https://pudo-academy.edu.vn"
