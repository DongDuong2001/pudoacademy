# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Cryptographically Strong JWT Secret (256-bit hex or base64)
JWT_SECRET="generate-with-crypto-randomBytes-32-hex"

# Optional: Fallback Secret for Zero-Downtime Key Rotation
# JWT_FALLBACK_SECRET="previous-secret-during-rotation"

# Optional: Neon Managed Auth Endpoints
# NEON_AUTH_BASE_URL="https://your-auth-endpoint.neonauth.tech/neondb/auth"
# NEON_AUTH_JWKS_URL="https://your-auth-endpoint.neonauth.tech/neondb/auth/.well-known/jwks.json"

# Base URL for Production Deployment & SEO Canonical Links
NEXT_PUBLIC_APP_URL="https://pudo-academy.edu.vn"
